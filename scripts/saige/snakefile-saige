def resolve_sav_file(wildcards):
    sav_directory = os.path.dirname(base_dir)
    sav_filename = os.path.basename(base_dir)

    if "chr1" not in sav_filename:
        raise ValueError(
             f"savs_path must contain a chr1 filename: {base_dir}"
            )

    sav_file = os.path.join(
            sav_directory,
            sav_filename.replace("chr1", wildcards.chrom, 1)
        )

    if not os.path.isfile(sav_file):
        raise FileNotFoundError(
            f"No .sav file found for chromosome {wildcards.chrom}: {sav_file}"
        )

    return sav_file



def resolve_step2_chrom_arg(wildcards):
    """
    Return the chromosome argument for step2_SPAtests.

    If lof is true:
        chr2 -> 2
    otherwise:
        chr2 -> chr2
    """
    chrom = wildcards.chrom
    if lof and chrom.lower().startswith("chr"):
        return chrom[3:]
    return chrom


def optional_config_arg(config_key, option_name):
    value = config.get(config_key)
    return f"--{option_name}={value}" if value is not None else ""


