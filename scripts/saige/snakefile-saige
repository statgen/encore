# ----------------------------
# Merge results (after ALL step2 files are produced)
# Equivalent to your Makefile awk|tr|bgzip
# ----------------------------
rule merge_step2_results:
    input:
        expected_step2_files
    output:
        final_bgz
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{outdir}"
        awk 'FNR!=1 || NR==1' {input} \
          | tr " " "\t" \
          | {bgzip} -c > {output}.tmp
        mv {output}.tmp {output}
        """

# ----------------------------
# Tabix index (creates .tbi)
# ----------------------------
rule tabix_index_results:
    input:
        final_bgz
    output:
        final_tbi
    shell:
        r"""
        set -euo pipefail
        {tabix} -s1 -b2 -e2 -S1 {input}
        """

# ----------------------------
# Combine logs into one gz
# Equivalent to: cat LOGNAME STEP2LOGS | gzip -c > LOGNAME.gz
# ----------------------------
rule gzip_logs:
    input:
        base_log = "saige.log",
        step2_logs = expected_step2_logs,
        tbi = final_tbi
    output:
        log_gz
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{outdir}"
        cat {input.base_log} {input.step2_logs} | gzip -c > {output}.tmp
        mv {output}.tmp {output}
        """
