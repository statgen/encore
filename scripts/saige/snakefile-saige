if use_regions:
    rule step2_SPAtests:
        input:
            savFile = resolve_sav_file,
            sampleFile = sample_file,
            GMMATmodelFile = "step1.rda",
            varianceRatioFile = "step1.varianceRatio.txt"

        output:
            SAIGEOutputFile = temp("step2.bin.{chrom}.{start}.{end}.txt")
        log:
            "step2_SPAtests_{chrom}.{start}.{end}.log"
        threads: 1
        params:
            chromVal = resolve_step2_chrom_arg,
            min_maf_arg = optional_config_arg("min_maf", "minMAF"),
            min_mac_arg = optional_config_arg("min_mac", "minMAC"),
            pCutoffforFirth = config.get("pCutoffforFirth", 0.05)
        shell:
            r"""
            set -euo pipefail

            range_file="$(mktemp)"
            trap 'rm -f "$range_file"' EXIT

            printf '%s\t%s\t%s\n' \
              '{params.chromVal}' \
              '{wildcards.start}' \
              '{wildcards.end}' \
              > "$range_file"

            set +e
            step2_SPAtests.R \
              --savFile={input.savFile} \
              --sampleFile={input.sampleFile} \
              --vcfField=GT \
              --SAIGEOutputFile={output.SAIGEOutputFile} \
              --chrom={params.chromVal} \
              --rangestoIncludeFile="$range_file" \
              {params.min_maf_arg} \
              {params.min_mac_arg} \
              --GMMATmodelFile={input.GMMATmodelFile} \
              --varianceRatioFile={input.varianceRatioFile} \
              --is_Firth_beta=FALSE \
              --pCutoffforFirth={params.pCutoffforFirth} \
              --is_output_moreDetails=TRUE \
              --LOCO=FALSE \
              > {log} 2>&1
            saige_status=$?
            set -e

            if grep -qF "No markers are left in VCF" {log}; then
              echo "No markers found in this region; creating an empty result." >> {log}
              : > {output.SAIGEOutputFile}
            elif [ "$saige_status" -ne 0 ]; then
              cat {log} >&2
              exit "$saige_status"
            fi
            """
