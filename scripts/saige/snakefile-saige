import os
import glob

# Required for process substitution: <(printf ...)
shell.executable("/bin/bash")



# Contig parameter is read from config.yaml file and then depedneing on the whole region or defined value will be passed.
chroms = config["contigs"]
if not isinstance(chroms, list) or not chroms:
    raise ValueError(
        "config['contigs'] must be a non-empty list"
    )

# Optionally split each requested chromosome into fixed-size intervals using the
# FASTA index.

reference_fasta = config.get("reference_fasta")
region_size = int(config.get("region_size", 500000))
if region_size <= 0:
    raise ValueError("config['region_size'] must be greater than zero")


def build_regions(contigs, fasta):
    if not fasta:
        return []

    fai = config.get("reference_fasta_index", f"{fasta}.fai")
    if not os.path.isfile(fai):
        raise FileNotFoundError(
            f"FASTA index not found: {fai}. Create it with: samtools faidx {fasta}"
        )

    lengths = {}
    with open(fai) as handle:
        for line in handle:
            fields = line.rstrip("\n").split("\t")
            if len(fields) >= 2:
                lengths[fields[0]] = int(fields[1])

    missing = [chrom for chrom in contigs if chrom not in lengths]
    if missing:
        raise ValueError(
            "Chromosome(s) missing from FASTA index {}: {}".format(
                fai, ", ".join(missing)
            )
        )

    return [
        (chrom, start, min(start + region_size - 1, lengths[chrom]))
        for chrom in contigs
        for start in range(1, lengths[chrom] + 1, region_size)
    ]


regions = build_regions(chroms, reference_fasta)
use_regions = bool(regions)
if use_regions:
    expected_step2_files = [
        f"step2.bin.{chrom}.{start}.{end}.txt"
        for chrom, start, end in regions
    ]
    expected_step2_logs = [
        f"step2_SPAtests_{chrom}.{start}.{end}.log"
